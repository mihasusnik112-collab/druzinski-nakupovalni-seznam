# Google Gemini API Ključ za prebiranje tedenskih PDF katalogov
GEMINI_API_KEY=vaš_gemini_api_kljuc

# Firebase konfiguracija (neobvezno za takojšnji zagon - vmesnik deluje tudi lokalno!)
VITE_FIREBASE_API_KEY=vaš_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=vaš-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vaš-projekt
VITE_FIREBASE_STORAGE_BUCKET=vaš-projekt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=vaš_sender_id
VITE_FIREBASE_APP_ID=vaš_app_id
